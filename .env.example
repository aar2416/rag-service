# --- Postgres + pgvector ---
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# --- Graph backend: postgres (default) | neo4j ---
GRAPH_BACKEND=postgres
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
NEO4J_DATABASE=neo4j

# --- Embeddings: local (sentence-transformers) | voyage ---
EMBEDDING_PROVIDER=local
# HF model id, or a folder under ./model, e.g. ./model/bge-small-en-v1.5
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
# For voyage: EMBEDDING_PROVIDER=voyage, EMBEDDING_MODEL=voyage-3.5, EMBEDDING_DIM=1024
# VOYAGE_API_KEY=

# --- Claude (entity extraction + answers) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
EXTRACTION_MODEL=claude-opus-5-5
LLM_EFFORT=medium
EXTRACTION_EFFORT=low
LLM_FALLBACKS=true
GRAPH_CONCURRENCY=4

# --- Chunking / retrieval ---
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
TOP_K_CHUNKS=6
TOP_K_ENTITIES=8
GRAPH_HOPS=2
MAX_RELATIONS=60
